# Copy to .env at the repo root:  cp .env.example .env
# Used by services via dotenv path ../../.env (from each package cwd).

NODE_ENV=development

# Client (Vite)
ISSUE_TRACKER_CLIENT_URL=http://localhost:3000
CLIENT_SERVER=http://localhost:3000
EMAIL_VERIFICATION_PAGE_PATH=verify-email

# Shared secrets (change for real use)
JWT_SECRET=dev-only-change-me-please

# Service HTTP ports (gateway uses 4000 — do not collide)
AUTH_SERVICE_PORT=4001
ISSUE_TRACKER_SERVICE_PORT=4002
ATTACHMENT_SERVICE_PORT=4003
# mail is a worker (no HTTP port required)

# Postgres (matches docker-compose.yaml host ports)
AUTH_POSTGRES_CLUSTER_URL=postgres://postgres:postgres@localhost:5431/postgres
ISSUE_TRACKER_POSTGRES_CLUSTER_URL=postgres://postgres:postgres@localhost:5432/postgres
MAIL_POSTGRES_CLUSTER_URL=postgres://postgres:postgres@localhost:5433/postgres
ATTACHMENT_POSTGRES_CLUSTER_URL=postgres://postgres:postgres@localhost:5434/postgres

# NATS JetStream
NATS_CLUSTER_URL=nats://localhost:4222

# Attachment Redis (compose maps 6380 -> 6379)
ATTACHMENT_REDIS_HOST=localhost
ATTACHMENT_REDIS_PORT=6380

# Optional: mail provider (mail service needs these to send real email)
BREVO_EMAIL=
BREVO_SECRET=

# Optional: Firebase storage for attachments
FIREBASE_STORAGE_BUCKET=
