# Copy to .env at the repo root:  cp .env.example .env
# Used by services via dotenv path ../../.env (from each package cwd).

NODE_ENV=development

# Client (Vite)
ISSUE_TRACKER_CLIENT_URL=http://localhost:3000
IDENTITY_CLIENT_URL=http://localhost:3001
CLIENT_SERVER=http://localhost:3000
EMAIL_VERIFICATION_PAGE_PATH=email-verification
# identity-web (Vite) — also set in apps/identity-web/.env
# VITE_API_BASE_URL=http://localhost:4000


# Shared secrets (change for real use)
JWT_SECRET=dev-only-change-me-please

# Service HTTP ports
API_GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=4001
ISSUE_TRACKER_SERVICE_PORT=4002
ATTACHMENT_SERVICE_PORT=4003
# mail is a worker (no HTTP port required)

# Gateway REST proxy upstreams (defaults derive from ports above)
# IDENTITY_SERVICE_URL=http://127.0.0.1:4001
# ATTACHMENT_SERVICE_URL=http://127.0.0.1:4003


# Postgres (matches infra/docker/compose.yaml host ports).
# Password segment must match POSTGRES_ADMIN_PASSWORD in infra/docker/.env
# (dotenv does not expand ${POSTGRES_ADMIN_PASSWORD} inside URLs).
# Docker secrets live in infra/docker/.env (see infra/docker/.env.example).
IDENTITY_POSTGRES_CLUSTER_URL=
ISSUE_TRACKER_POSTGRES_CLUSTER_URL=
MAIL_POSTGRES_CLUSTER_URL=
ATTACHMENT_POSTGRES_CLUSTER_URL=

# NATS JetStream
NATS_CLUSTER_URL=nats://localhost:4222

# Ory Kratos (infra/docker/compose.kratos.yaml publishes 4433 public, 4434 admin).
# Public: self-service flows. Admin: identity management API.
# Matches serve.public / host-mapped admin ports in identity/kratos/kratos.yaml.
KRATOS_PUBLIC_URL=http://127.0.0.1:4433
KRATOS_ADMIN_URL=http://127.0.0.1:4434

# Attachment Redis (compose maps 6380 -> 6379)
ATTACHMENT_REDIS_HOST=localhost
ATTACHMENT_REDIS_PORT=6380

# Optional: mail provider (mail service needs these to send real email)
BREVO_EMAIL=
BREVO_SECRET=

# OpenTelemetry → Grafana Alloy (OTLP gRPC). Host port maps to alloy:4317 in compose.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

