    "@tanstack/react-router": "1.170.17",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.11",
    "firebase": "^10.12.2",
    "graphql": "^16.9.0",
    "graphql-request": "^7.4.0",
    "lodash": "^4.17.21",
    "notistack": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "react-redux": "^8.1.3",
    "zustand": "^5.0.14"
  }
}
