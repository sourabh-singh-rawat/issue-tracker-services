    {
      "name": "client (browser)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/erp-web",
      "sourceMaps": true,
      "userDataDir": true,
      "presentation": { "group": "4-browser", "order": 1 },
      "pathMapping": {
        "/@fs": ""
      },
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/src/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/src/*",
        "webpack:///*": "*",
        "/@fs/*": "/*",
        "/src/*": "${webRoot}/src/*"
      }
    },
