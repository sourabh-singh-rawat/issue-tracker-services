{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "dev",
      "presentation": {
        "group": "dev",
        "order": 1
      },
      "stopAll": true,
      "configurations": [
        "identity-service",
        "issues-service",
        "inventory-service",
        "attachment-service",
        "notification-service",
        "api-gateway",
        "erp-web",
        "identity-web",
        "schemas:watch",
        "codegen: supergraph"
      ]
    },
    {
      "name": "dev + browser",
      "presentation": {
        "group": "dev",
        "order": 2
      },
      "stopAll": true,
      "configurations": [
        "identity-service",
        "issues-service",
        "inventory-service",
        "attachment-service",
        "notification-service",
        "api-gateway",
        "erp-web",
        "identity-web",
        "client (browser)",
        "schemas:watch",
        "codegen: supergraph"
      ]
    },
    {
      "name": "dev (linux + browser)",
      "presentation": {
        "group": "dev",
        "order": 3
      },
      "stopAll": true,
      "configurations": [
        "identity-service",
        "issues-service",
        "inventory-service",
        "attachment-service",
        "notification-service",
        "api-gateway",
        "erp-web",
        "identity-web",
        "brave (debug)",
        "schemas:watch",
        "codegen: supergraph"
      ]
    }
  ],
  "configurations": [
    {
      "name": "erp-web",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["erp-web"],
      "console": "integratedTerminal"
    },
    {
      "name": "identity-web",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["identity-web"],
      "console": "integratedTerminal"
    },
    {
      "name": "erp-web + browser",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["erp-web"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "webRoot": "${workspaceFolder}/apps/erp-web"
      }
    },
    {
      "name": "client (browser)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/erp-web",
      "sourceMaps": true,
      "userDataDir": true,
      "pathMapping": {
        "/@fs": ""
      },
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/src/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/src/*",
        "webpack:///*": "*",
        "/@fs/*": "/*",
        "/src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "client (browser - edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/erp-web",
      "sourceMaps": true,
      "userDataDir": true,
      "pathMapping": {
        "/@fs": ""
      },
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/src/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/src/*",
        "webpack:///*": "*",
        "/@fs/*": "/*",
        "/src/*": "${webRoot}/src/*"
      }
    },
    {
      "name": "brave (debug - scoop)",
      "request": "launch",
      "type": "chrome",
      "runtimeExecutable": "C:\\Users\\Soura\\scoop\\apps\\brave\\current\\brave.exe",
      "userDataDir": true,
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/erp-web",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true
    },
    {
      "name": "brave (debug)",
      "request": "launch",
      "type": "chrome",
      "runtimeExecutable": "/usr/bin/brave",
      "userDataDir": true,
      "url": "http://localhost:3001",
      "webRoot": "${workspaceFolder}/apps/erp-web",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true
    },
    {
      "name": "identity-service",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["identity-service"],
      "console": "integratedTerminal"
    },
    {
      "name": "notification-service",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["notification-service"],
      "console": "integratedTerminal"
    },
    {
      "name": "issues-service",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["issues-service"],
      "console": "integratedTerminal"
    },
    {
      "name": "inventory-service",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["inventory-service"],
      "console": "integratedTerminal"
    },
    {
      "name": "attachment-service",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["attachment-service"],
      "console": "integratedTerminal"
    },
    {
      "name": "api-gateway",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["api-gateway"],
      "console": "integratedTerminal"
    },
    {
      "name": "schemas:watch",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["schemas:watch"],
      "console": "integratedTerminal"
    },
    {
      "name": "codegen: supergraph",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["gen"],
      "console": "integratedTerminal"
    }
  ]
}
