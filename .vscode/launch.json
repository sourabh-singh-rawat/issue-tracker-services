{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "dev",
      "stopAll": true,
      "preLaunchTask": "dev:prepare",
      "configurations": [
        "auth",
        "issue-tracker",
        "attachment",
        "mail",
        "gateway",
        "issue-tracker (client)",
        "codegen: supergraph"
      ]
    },
    {
      "name": "dev (apps only)",
      "stopAll": true,
      "configurations": [
        "auth",
        "issue-tracker",
        "attachment",
        "mail",
        "gateway",
        "issue-tracker (client)",
        "codegen: supergraph"
      ]
    },
    {
      "name": "dev (linux + browser)",
      "stopAll": true,
      "preLaunchTask": "dev:prepare",
      "configurations": [
        "auth",
        "issue-tracker",
        "attachment",
        "mail",
        "gateway",
        "issue-tracker (client)",
        "brave (debug)",
        "codegen: supergraph"
      ]
    }
  ],
  "configurations": [
    {
      "name": "issue-tracker (client)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["client"],
      "console": "integratedTerminal"
    },
    {
      "name": "brave (debug - scoop)",
      "request": "launch",
      "type": "chrome",
      "runtimeExecutable": "C:\\Users\\Soura\\scoop\\apps\\brave\\current\\brave.exe",
      "userDataDir": true,
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/clients/issue-tracker",
      "runtimeArgs": ["--remote-debugging-port=9222"]
    },
    {
      "name": "brave (debug)",
      "request": "launch",
      "type": "chrome",
      "runtimeExecutable": "/usr/bin/brave",
      "userDataDir": true,
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/clients/issue-tracker",
      "runtimeArgs": ["--remote-debugging-port=9222"]
    },
    {
      "name": "auth",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["auth"],
      "console": "integratedTerminal"
    },
    {
      "name": "mail",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["mail"],
      "console": "integratedTerminal"
    },
    {
      "name": "issue-tracker",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["issue-tracker"],
      "console": "integratedTerminal"
    },
    {
      "name": "attachment",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["attachment"],
      "console": "integratedTerminal"
    },
    {
      "name": "gateway",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["gateway"],
      "console": "integratedTerminal"
    },
    {
      "name": "codegen: supergraph",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["gen"],
      "console": "integratedTerminal"
    }
  ]
}
