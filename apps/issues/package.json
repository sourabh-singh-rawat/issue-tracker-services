{
  "name": "@pine/issue-web",
  "version": "0.0.0",
  "description": "React client for Pine issues",
  "private": "true",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen:rest": "npx @rtk-query/codegen-openapi codegen.rest.ts",
    "gen": "graphql-codegen --config codegen.gql.ts --watch",
    "gen:once": "graphql-codegen --config codegen.gql.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/issue-tracker.git"
  },
  "keywords": [
    "issue-tracker",
    "react",
    "client"
  ],
  "author": "Sourabh Singh Rawat",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/issue-tracker/issues"
  },
  "homepage": "https://github.com/sourabh-singh-rawat/issue-tracker#readme",
  "devDependencies": {
    "@babel/core": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-react": "^7.24.6",
    "@babel/preset-typescript": "^7.24.6",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "5.0.3",
    "@graphql-codegen/client-preset": "4.5.1",
    "@graphql-codegen/import-types-preset": "^4.0.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.0",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@parcel/watcher": "^2.5.0",
    "@rtk-query/codegen-openapi": "^1.2.0",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "1.168.19",
    "@testing-library/react": "^14.3.1",
    "@types/lodash": "^4.17.4",
    "@types/node": "^20.12.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.33",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@graphql-codegen/cli": "^5.0.3",
    "@hookform/resolvers": "^3.9.0",
    "@pine/common": "workspace:*",
    "@mui/base": "5.0.0-beta.63",
    "@mui/icons-material": "6.1.9",
    "@mui/material": "6.1.9",
    "@mui/system": "6.1.9",
    "@mui/x-data-grid": "^6.20.0",
    "@mui/x-date-pickers": "^6.20.0",
    "@reduxjs/toolkit": "^1.9.7",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.17",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.11",
    "firebase": "^10.12.2",
    "graphql": "^16.9.0",
