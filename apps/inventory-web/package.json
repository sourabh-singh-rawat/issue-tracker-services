{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/inventory-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "gen": "pnpm gen:gql && pnpm gen:api",
    "gen:gql": "graphql-codegen --config graphql-codegen.ts",
    "gen:api": "pnpm dlx --package typescript@5.8.3 --package @hey-api/openapi-ts@0.99.0 openapi-ts --file openapi-codegen.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hey-api/client-axios": "0.9.1",
    "@tanstack/react-query": "5.101.3",
    "axios": "^1.18.1",
    "graphql": "^17.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.0",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/react-query-devtools": "5.101.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "7.0.2",
    "vite": "^8.1.1"
  }
}
