{
  "$schema": "https://cdn.jsdelivr.net/npm/oxlint@1/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "jsPlugins": ["./tools/oxlint/pine-plugin.js"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/__generated__/**",
    "**/routeTree.gen.ts",
    "**/api/codegen/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/build/**"
  ],
  "rules": {
    "max-lines": ["error", { "max": 300 }],
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": true
      }
    ],
    "pine/no-destructure-query-mutation": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@mui/icons-material",
            "message": "Import icons via path imports, e.g. `import Icon from '@mui/icons-material/Icon'`, not from the package barrel."
          }
        ]
      }
    ]
  }
}
