# Copy next to compose.yaml:
#   cp infra/docker/.env.example infra/docker/.env
#
# Used only by Docker Compose for container env interpolation
# (POSTGRES_ADMIN_PASSWORD, PGADMIN_*). App/runtime config stays in the
# monorepo root .env.

# Admin role
POSTGRES_ADMIN_PASSWORD=

# Service roles
POSTGRES_IDENTITY_PASSWORD=
POSTGRES_ISSUES_PASSWORD=
POSTGRES_MAIL_PASSWORD=
POSTGRES_ATTACHMENT_PASSWORD=
POSTGRES_KRATOS_PASSWORD=
POSTGRES_HYDRA_PASSWORD=

PGADMIN_DEFAULT_EMAIL=pgadmin@example.com
PGADMIN_DEFAULT_PASSWORD=

# Ory Kratos (compose.kratos.yaml) — cookie secret any string; cipher must be 32 chars.
# Kratos and Hydra share ory-postgres (compose.ory-db.yaml) with separate DB users above.
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=

# Ory Hydra (compose.hydra.yaml) — system secret used to encrypt DB data
HYDRA_SECRETS_SYSTEM=

# Observability
GRAFANA_ADMIN_PASSWORD=
