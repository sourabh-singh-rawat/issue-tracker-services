# Copy next to compose.yaml:
#   cp infra/docker/.env.example infra/docker/.env
#
# Used only by Docker Compose for container env interpolation
# (POSTGRES_ADMIN_PASSWORD, PGADMIN_*). App/runtime config stays in the
# monorepo root .env.

# Admin role
POSTGRES_ADMIN_PASSWORD=

# Service roles
POSTGRES_AUTH_PASSWORD=
POSTGRES_ISSUES_PASSWORD=
POSTGRES_MAIL_PASSWORD=
POSTGRES_ATTACHMENT_PASSWORD=
PGADMIN_DEFAULT_EMAIL=pgadmin@example.com
PGADMIN_DEFAULT_PASSWORD=

# Observability
GRAFANA_ADMIN_PASSWORD=
