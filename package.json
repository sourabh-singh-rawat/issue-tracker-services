{
  "name": "issue-tracker",
  "version": "1.0.0",
  "description": "A mono repo for web application that track issues in your projects",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev:apps": "nx run-many -t dev --projects=client,auth,attachment,mail,issue-tracker,gateway --parallel=10",
    "client": "nx run client:dev",
    "server": "skaffold dev",
    "issue-tracker": "nx run issue-tracker:dev",
    "auth": "nx run auth:dev",
    "mail": "nx run mail:dev",
    "attachment": "nx run attachment:dev",
    "gateway": "nx run gateway:dev",
    "gen": "nx run client:gen",
    "build": "nx run-many -t build",
    "build:server": "nx run-many -t build --exclude=client,@issue-tracker/forms",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "graph": "nx graph",
    "nx:reset": "nx reset",
    "gql:compose": "rover supergraph compose --elv2-license accept --config supergraph-config-dev.yaml > services/gateway/supergraph.graphql",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "pnpm": ">=9.0.4",
    "node": ">=20.13.1"
  },
  "devDependencies": {
    "@apollo/rover": "^0.34.1",
    "@changesets/cli": "^2.31.0",
    "@redocly/cli": "^1.27.1",
    "nx": "23.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-sort-imports": "^1.8.8"
  }
}
