{
  "name": "issue-tracker",
  "version": "0.0.0",
  "description": "A mono repo for web application that track issues in your projects",
  "scripts": {
    "dev:infra": "docker compose -f infra/docker/docker-compose.yaml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yaml down",
    "dev:apps": "nx run-many -t dev --projects=@issue-tracker/web,@issue-tracker/auth,@issue-tracker/attachment,@issue-tracker/mail,@issue-tracker/issues,@issue-tracker/gateway --parallel=10",
    "client": "nx run @issue-tracker/web:dev",
    "web": "nx run @issue-tracker/web:dev",
    "server": "skaffold dev",
    "issue-tracker": "nx run @issue-tracker/issues:dev",
    "issues": "nx run @issue-tracker/issues:dev",
    "auth": "nx run @issue-tracker/auth:dev",
    "mail": "nx run @issue-tracker/mail:dev",
    "attachment": "nx run @issue-tracker/attachment:dev",
    "gateway": "nx run @issue-tracker/gateway:dev",
    "gen": "nx run @issue-tracker/web:gen",
    "build": "nx run-many -t build",
    "build:server": "nx run-many -t build --exclude=@issue-tracker/web,@issue-tracker/forms",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "graph": "nx graph",
    "nx:reset": "nx reset",
    "gql:compose": "rover supergraph compose --elv2-license accept --config supergraph-config-dev.yaml > services/gateway/supergraph.graphql",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset publish",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "pnpm": ">=9.0.4",
    "node": ">=20.13.1"
  },
  "devDependencies": {
    "@apollo/rover": "^0.34.1",
    "@changesets/cli": "^2.31.0",
    "@redocly/cli": "^1.34.17",
    "depcheck": "^1.4.7",
    "nx": "23.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.11",
    "simple-git-hooks": "^2.13.1",
    "typescript": "npm:@typescript/native-preview@7.0.0-dev.20260707.2"
  }
}