{
  "name": "issue-tracker",
  "version": "1.0.0",
  "description": "A mono repo for web application that track issues in your projects",
  "scripts": {
    "client": "pnpm -F client run dev",
    "server": "skaffold dev",
    "issue-tracker": "pnpm -F @issue-tracker-services/issue-tracker run dev",
    "auth": "pnpm -F auth run dev",
    "mail": "pnpm -F mail run dev",
    "attachment": "pnpm -F attachment run dev",
    "gen": "pnpm -F client run gen",
    "build": "pnpm -r --filter=!client build",
    "gql:compose": "rover supergraph compose --elv2-license accept --config supergraph-config-dev.yaml > services/gateway/supergraph.graphql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "pnpm": ">=9.0.4",
    "node": ">=20.13.1"
  },
  "devDependencies": {
    "@apollo/rover": "^0.34.1",
    "@redocly/cli": "^1.27.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-sort-imports": "^1.8.8"
  }
}