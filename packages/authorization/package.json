{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/authorization",
  "version": "0.3.0",
  "private": true,
  "description": "Shared authorization catalog and service-to-service client for relationship checks",
  "keywords": [
    "authorization",
    "capabilities",
    "resources",
    "roles"
  ],
  "license": "ISC",
  "author": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node ../../tools/scripts/rm-rf.mjs dist",
    "build": "pnpm clean && tsc"
  },
  "dependencies": {
    "@pine/errors": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "7.0.2"
  }
}
