{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/authorization",
  "version": "0.0.0",
  "private": true,
  "description": "Shared authorization constants — resources (including capabilities), roles, and stable seed IDs",
  "keywords": [
    "authorization",
    "resources",
    "capabilities",
    "roles"
  ],

  "license": "ISC",
  "author": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
