{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/issues-service",
  "version": "0.2.0",
  "description": "Issues, projects, workspaces, and statuses",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "./src/main.ts",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
