{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/inventory-service",
  "version": "0.2.0",
  "description": "Inventory service — stock and inventory domain",
  "keywords": [
    "inventory",
    "stock"
  ],
  "homepage": "https://github.com/sourabh-singh-rawat/issue-tracker#readme",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/issue-tracker/issues"
  },
  "license": "ISC",
  "author": "Sourabh Singh Rawat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/issue-tracker.git"
  },
  "main": "./src/main.ts",
  "scripts": {
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "tsx --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "tsx --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "tsx --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@pine/common": "workspace:^",
    "@pine/errors": "workspace:^",
    "@pine/events": "workspace:^",
    "@pine/http-core": "workspace:^",
    "@pine/observability": "workspace:*",
    "@pine/security": "workspace:^",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.10.0",
    "http-status-codes": "^2.3.0",
    "inversify": "8.2.2",
    "nats": "^2.29.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "0.31.8",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
