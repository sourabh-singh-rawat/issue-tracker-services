{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/authorization-service",
  "version": "0.1.0",
  "description": "Authorization service — roles and access control domain",
  "keywords": [
    "authorization",
    "roles"
  ],
  "homepage": "https://github.com/sourabh-singh-rawat/issue-tracker#readme",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/issue-tracker/issues"
  },
  "license": "ISC",
  "author": "Sourabh Singh Rawat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/issue-tracker.git"
  },
  "main": "./src/main.ts",
  "scripts": {
    "clean": "node ../../tools/scripts/rm-rf.mjs dist",
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "cli:grant-super-admin": "tsx --env-file=../../.env src/cli/grant-super-admin.ts"
  },
  "dependencies": {
    "@ory/keto-client": "26.2.0",
    "@pine/authorization": "workspace:^",
    "@pine/common": "workspace:^",
    "@pine/errors": "workspace:^",
    "@pine/events": "workspace:^",
    "@pine/server": "workspace:^",
    "@pine/identity-client": "workspace:^",
    "@pine/observability": "workspace:*",
    "@pine/outbox": "workspace:^",
    "@pothos/core": "^4.13.1",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "graphql-scalars": "^1.25.0",
    "http-status-codes": "^2.3.0",
    "inversify": "8.2.2",
    "nats": "^2.29.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.8",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
