{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/mail-service",
  "version": "0.2.0",
  "description": "Mail service",
  "keywords": [
    "email",
    "mail-service",
    "management"
  ],
  "homepage": "https://github.com/sourabh-singh-rawat/issue-tracker#readme",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/issue-tracker/issues"
  },
  "license": "ISC",
  "author": "Sourabh Singh Rawat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/issue-tracker.git"
  },
  "main": "./src/main.ts",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@pine/common": "workspace:^",
    "@pine/events": "workspace:^",
    "@pine/http-core": "workspace:^",
    "@pine/orm": "workspace:^",
    "@pine/security": "workspace:^",
    "fastify": "^5.10.0",
    "http-status-codes": "^2.3.0",
    "inversify": "8.2.2",
    "nats": "^2.29.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typebox": "1.3.6",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
